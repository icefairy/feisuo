# 飞梭 (feisuo) 配置文件
# 复制为 feisuo.yaml 并填写
#
# 引擎与模型凭据复用 CLI 自身配置，feisuo 不需要 api_key/model：
#   - pi 引擎：用 pi auth / models.json 中配置的默认 provider、模型与凭据
#   - codebuddy 引擎：用本机登录凭据与默认模型
#
# 会话工作目录不在此配置：每个会话用 /NEW <名> --dir <路径> 或 /CD <会话> <路径> 绑定，
# 绑定后对应 Agent 进程在该目录内开发；未绑定的会话用 feisuo 启动目录。

# 引擎选择：pi | codebuddy（默认 pi，向后兼容）
engine: "pi"

feishu:
  app_id: "cli_xxxxxxxxxx"
  app_secret: "xxxxxxxxxxxxxxx"
  bot_name: "飞梭"
  # 飞书 WebSocket 端点（在飞书开发者后台获取）
  ws_url: "wss://open.feishu.cn/ws/v1/ws/"

# Pi 引擎配置（engine: pi 时使用）
# provider/model/api_key 均可选：不填则用 pi 自身配置
pi:
  binary: "pi"        # Linux: "pi"；Windows: "pi.cmd"（代码自动 LookPath 解析）
  timeout: 1800       # 单任务超时（秒）

# CodeBuddy 引擎配置（engine: codebuddy 时使用）
# 使用本机登录凭据，无需 api_key；headless 权限全通过（无人值守不弹审批）
codebuddy:
  binary: "codebuddy"
  timeout: 1800       # 单任务超时（秒）

sessions:
  data_dir: "~/.feisuo/sessions"   # Windows 可写 "C:\\Users\\你\\.feisuo\\sessions"
  default_name: "main"
