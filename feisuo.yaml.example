# 飞梭 (feisuo) 配置文件
# 复制为 feisuo.yaml 并填写

# 引擎选择：pi | codebuddy（默认 pi，向后兼容）
engine: "pi"

feishu:
  app_id: "cli_xxxxxxxxxx"
  app_secret: "xxxxxxxxxxxxxxx"
  bot_name: "飞梭"
  # 飞书 WebSocket 端点（在飞书开发者后台获取）
  ws_url: "wss://open.feishu.cn/ws/v1/ws/"

# Pi 引擎配置（engine: pi 时使用）
pi:
  binary: "pi"        # Linux: "pi"；Windows: "pi.cmd"（代码自动 LookPath 解析）
  provider: "agentrium"
  model: "deepseek-v4-flash"
  base_url: "http://127.0.0.1:3000/v1"   # OpenAI 兼容端点
  api_key: "your-api-key-here"
  timeout: 300  # 单任务超时（秒）

# CodeBuddy 引擎配置（engine: codebuddy 时使用）
# codebuddy 使用本机登录凭据，无需 api_key
# 支持 -p --input-format stream-json 常驻模式
codebuddy:
  binary: "codebuddy"         # CLI 路径，默认 "codebuddy"
  model: "deepseek-v4.1-flash"  # 可选，不填则用默认模型
  api_key: ""                 # 可选，非空时设置 CODEBUDDY_API_KEY
  timeout: 1800               # 单任务超时（秒）

sessions:
  data_dir: "~/.feisuo/sessions"   # Windows 可写 "C:\\Users\\你\\.feisuo\\sessions"
  default_name: "main"
